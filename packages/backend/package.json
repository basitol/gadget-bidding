{
  "name": "@gadget-bidding/backend",
  "version": "1.0.0",
  "description": "Backend API server for Gadget Bidding platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && cp -R src/generated dist/generated",
    "start": "node dist/index.js",
    "type-check": "pnpm --filter @gadget-bidding/shared build && tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests --roots src",
    "migrate:create": "node scripts/create-migration.js",
    "migrate:up": "node scripts/run-migrations.js up",
    "migrate:down": "node scripts/run-migrations.js down",
    "db:setup": "psql -f src/database/schema.sql",
    "db:sync": "psql -f src/database/migrations/001_sync_prisma_schema.sql",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:validate:empty": "bash scripts/db-validate-empty.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "test:payments:e2e": "bash scripts/payment-e2e.sh",
    "smoke:admin": "node scripts/admin-smoke.js",
    "env:audit": "pnpm build && node scripts/env-audit.js",
    "webhook:replay:paystack": "node scripts/paystack-webhook-replay.js",
    "seed:staging": "ts-node src/scripts/seed-staging.ts"
  },
  "dependencies": {
    "@gadget-bidding/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "bull": "^4.12.0",
    "cloudinary": "^2.0.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.18.0",
    "redis": "^4.6.12",
    "socket.io": "^4.6.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prisma": "^7.3.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
