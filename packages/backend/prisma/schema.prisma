generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============== MODELS ==============

model User {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber              String    @unique @map("phone_number") @db.VarChar(15)
  email                    String?   @unique @db.VarChar(255)
  username                 String?   @unique @db.VarChar(20)
  fullName                 String    @map("full_name") @db.VarChar(255)
  passwordHash             String    @map("password_hash") @db.VarChar(255)
  avatarUrl                String?   @map("avatar_url")
  role                     String    @default("bidder") @db.VarChar(20)
  isVerified               Boolean?  @default(false) @map("is_verified")
  isActive                 Boolean?  @default(true) @map("is_active")
  businessName             String?   @map("business_name") @db.VarChar(255)
  cacNumber                String?   @map("cac_number") @db.VarChar(50)
  sellerKybStatus          String    @default("not_started") @map("seller_kyb_status") @db.VarChar(20)
  sellerKybSubmittedAt     DateTime? @map("seller_kyb_submitted_at") @db.Timestamp(6)
  sellerKybReviewedAt      DateTime? @map("seller_kyb_reviewed_at") @db.Timestamp(6)
  sellerKybRejectionReason String?   @map("seller_kyb_rejection_reason") @db.VarChar(500)
  acceptedTermsAt          DateTime? @map("accepted_terms_at") @db.Timestamp(6)
  /// What the buyer said they're hunting for at sign-up: { categories: string[], budget: string }
  interests                Json?
  /// Alert switches from Settings: { bids, orders, marketing }. Null = defaults.
  notificationPrefs        Json?     @map("notification_prefs")
  /// 2-step sign-in: an emailed code after the password.
  twoFactorEnabled         Boolean   @default(false) @map("two_factor_enabled")
  createdAt                DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  wallet              Wallet?
  gadgets             Gadget[]
  sellerAuctions      Auction[]            @relation("SellerAuctions")
  wonAuctions         Auction[]            @relation("WonAuctions")
  bids                Bid[]
  buyerOrders         Order[]              @relation("BuyerOrders")
  sellerOrders        Order[]              @relation("SellerOrders")
  raisedDisputes      Dispute[]            @relation("RaisedDisputes")
  resolvedDisputes    Dispute[]            @relation("ResolvedDisputes")
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  verifications       UserVerification[]
  paymentTransactions PaymentTransaction[]
  auditLogs           AuditLog[]
  riskFlags           UserRiskFlag[]
  supportThreads      SupportThread[]      @relation("SellerSupportThreads")
  supportMessages     SupportMessage[]
  addresses           UserAddress[]
  socialAccounts      SocialAccount[]
  pushTokens          PushToken[]
  watchlist           Watch[]
  autoBids            AutoBid[]
  savedSearches       SavedSearch[]
  savedCards          SavedCard[]
  ratingsGiven        Rating[]             @relation("RatingsGiven")
  ratingsReceived     Rating[]             @relation("RatingsReceived")
  following           Follow[]             @relation("Following")
  followers           Follow[]             @relation("Followers")

  @@index([phoneNumber], map: "idx_users_phone")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model SocialAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String    @map("provider") @db.VarChar(20)
  providerUserId String    @map("provider_user_id") @db.VarChar(255)
  email          String?   @map("email") @db.VarChar(255)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([provider, providerUserId], map: "uq_social_accounts_provider_user")
  @@index([userId], map: "idx_social_accounts_user")
  @@map("social_accounts")
}

model Wallet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @unique @map("user_id") @db.Uuid
  balance   Decimal?  @default(0.00) @db.Decimal(15, 2)
  currency  String?   @default("NGN") @db.VarChar(3)
  isLocked  Boolean?  @default(false) @map("is_locked")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions WalletTransaction[]
  bidHolds     BidHold[]

  @@index([userId], map: "idx_wallets_user")
  @@map("wallets")
}

model WalletTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String?   @map("wallet_id") @db.Uuid
  transactionType String    @map("transaction_type") @db.VarChar(20)
  amount          Decimal   @db.Decimal(15, 2)
  balanceBefore   Decimal   @map("balance_before") @db.Decimal(15, 2)
  balanceAfter    Decimal   @map("balance_after") @db.Decimal(15, 2)
  reference       String?   @unique @db.VarChar(255)
  description     String?
  metadata        Json?
  status          String?   @default("pending") @db.VarChar(20)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  wallet              Wallet?              @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  paymentTransactions PaymentTransaction[]

  @@index([status], map: "idx_wallet_transactions_status")
  @@index([walletId, createdAt(sort: Desc)], map: "idx_wallet_transactions_wallet")
  @@map("wallet_transactions")
}

model GadgetCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?
  iconUrl     String?   @map("icon_url")
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  gadgets Gadget[]

  @@index([slug], map: "idx_gadget_categories_slug")
  @@map("gadget_categories")
}

model Gadget {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId             String?   @map("seller_id") @db.Uuid
  categoryId           String?   @map("category_id") @db.Uuid
  title                String    @db.VarChar(255)
  description          String
  brand                String?   @db.VarChar(100)
  model                String?   @db.VarChar(100)
  condition            String    @db.VarChar(20)
  specifications       Json?
  images               String[]
  status               String?   @default("pending") @db.VarChar(20)
  rejectionReason      String?   @map("rejection_reason")
  auctionStartingPrice Decimal?  @map("auction_starting_price") @db.Decimal(15, 2)
  auctionReservePrice  Decimal?  @map("auction_reserve_price") @db.Decimal(15, 2)
  auctionBuyNowPrice   Decimal?  @map("auction_buy_now_price") @db.Decimal(15, 2)
  auctionBidIncrement  Decimal?  @map("auction_bid_increment") @db.Decimal(15, 2)
  auctionDurationHours Int?      @map("auction_duration_hours")
  auctionStartNow      Boolean?  @default(true) @map("auction_start_now")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  seller   User?           @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category GadgetCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auction  Auction?

  @@index([categoryId], map: "idx_gadgets_category")
  @@index([sellerId, status], map: "idx_gadgets_seller")
  @@index([status], map: "idx_gadgets_status")
  @@map("gadgets")
}

model Auction {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gadgetId          String?   @unique @map("gadget_id") @db.Uuid
  sellerId          String?   @map("seller_id") @db.Uuid
  startingPrice     Decimal   @map("starting_price") @db.Decimal(15, 2)
  reservePrice      Decimal?  @map("reserve_price") @db.Decimal(15, 2)
  currentPrice      Decimal   @map("current_price") @db.Decimal(15, 2)
  bidIncrement      Decimal?  @default(100.00) @map("bid_increment") @db.Decimal(15, 2)
  buyNowPrice       Decimal?  @map("buy_now_price") @db.Decimal(15, 2)
  startTime         DateTime  @map("start_time") @db.Timestamp(6)
  endTime           DateTime  @map("end_time") @db.Timestamp(6)
  status            String?   @default("scheduled") @db.VarChar(20)
  winnerId          String?   @map("winner_id") @db.Uuid
  totalBids         Int?      @default(0) @map("total_bids")
  autoExtendEnabled Boolean?  @default(true) @map("auto_extend_enabled")
  autoExtendMinutes Int?      @default(5) @map("auto_extend_minutes")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  gadget   Gadget?   @relation(fields: [gadgetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seller   User?     @relation("SellerAuctions", fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  winner   User?     @relation("WonAuctions", fields: [winnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bids     Bid[]
  order    Order?
  watchers Watch[]
  autoBids AutoBid[]

  @@index([sellerId], map: "idx_auctions_seller")
  @@index([status, startTime, endTime], map: "idx_auctions_status")
  @@map("auctions")
}

model Bid {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId String?   @map("auction_id") @db.Uuid
  bidderId  String?   @map("bidder_id") @db.Uuid
  amount    Decimal   @db.Decimal(15, 2)
  bidTime   DateTime? @default(now()) @map("bid_time") @db.Timestamp(6)
  isWinning Boolean?  @default(false) @map("is_winning")
  isAutoBid Boolean?  @default(false) @map("is_auto_bid")
  status    String?   @default("active") @db.VarChar(20)

  // Relations
  auction Auction? @relation(fields: [auctionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bidder  User?    @relation(fields: [bidderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bidHold BidHold?

  @@unique([auctionId, bidderId, amount], map: "unique_bid_per_user_price")
  @@index([auctionId, bidTime(sort: Desc)], map: "idx_bids_auction_time")
  @@index([bidderId, bidTime(sort: Desc)], map: "idx_bids_bidder")
  @@index([status], map: "idx_bids_status")
  @@map("bids")
}

model BidHold {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId      String?   @unique @map("bid_id") @db.Uuid
  walletId   String?   @map("wallet_id") @db.Uuid
  amount     Decimal   @db.Decimal(15, 2)
  status     String?   @default("held") @db.VarChar(20)
  releasedAt DateTime? @map("released_at") @db.Timestamp(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  bid    Bid?    @relation(fields: [bidId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bidId], map: "idx_bid_holds_bid")
  @@index([walletId, status], map: "idx_bid_holds_wallet")
  @@map("bid_holds")
}

model Order {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId         String?   @unique @map("auction_id") @db.Uuid
  buyerId           String?   @map("buyer_id") @db.Uuid
  sellerId          String?   @map("seller_id") @db.Uuid
  orderNumber       String    @unique @map("order_number") @db.VarChar(50)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(15, 2)
  platformFee       Decimal?  @default(0.00) @map("platform_fee") @db.Decimal(15, 2)
  sellerPayout      Decimal   @map("seller_payout") @db.Decimal(15, 2)
  /// Flat delivery charge included in totalAmount (goes to the platform, not the seller).
  deliveryFee       Decimal   @default(0) @map("delivery_fee") @db.Decimal(15, 2)
  /// 'delivery' (to the buyer's address) or 'pickup' (collect at the Computer Village hub, free).
  deliveryMethod    String    @default("delivery") @map("delivery_method") @db.VarChar(10)
  payoutStatus      String?   @default("pending") @map("payout_status") @db.VarChar(20)
  payoutPaidAt      DateTime? @map("payout_paid_at") @db.Timestamp(6)
  payoutReference   String?   @map("payout_reference") @db.VarChar(100)
  paymentStatus     String?   @default("pending") @map("payment_status") @db.VarChar(20)
  fulfillmentStatus String?   @default("pending") @map("fulfillment_status") @db.VarChar(50)
  shippingAddress   Json?     @map("shipping_address")
  trackingNumber    String?   @map("tracking_number") @db.VarChar(100)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  auction  Auction?  @relation(fields: [auctionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  buyer    User?     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seller   User?     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  disputes Dispute[]
  ratings  Rating[]
  events   OrderEvent[]

  @@index([buyerId, paymentStatus], map: "idx_orders_buyer")
  @@index([orderNumber], map: "idx_orders_order_number")
  @@index([sellerId, fulfillmentStatus], map: "idx_orders_seller")
  @@index([payoutStatus, fulfillmentStatus], map: "idx_orders_payout")
  @@index([paymentStatus, fulfillmentStatus], map: "idx_orders_status")
  @@map("orders")
}

/// One row per payment/fulfillment status change, written by the orders_record_event DB trigger.
model OrderEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  /// 'payment' or 'fulfillment'
  kind      String   @db.VarChar(20)
  status    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId, createdAt], map: "idx_order_events_order")
  @@map("order_events")
}

model Dispute {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String?   @map("order_id") @db.Uuid
  raisedBy    String?   @map("raised_by") @db.Uuid
  disputeType String    @map("dispute_type") @db.VarChar(50)
  description String
  evidence    Json?
  status      String?   @default("open") @db.VarChar(20)
  resolution  String?
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  order    Order? @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  raiser   User?  @relation("RaisedDisputes", fields: [raisedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolver User?  @relation("ResolvedDisputes", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_disputes_order")
  @@index([raisedBy], map: "idx_disputes_raised_by")
  @@index([status, createdAt(sort: Desc)], map: "idx_disputes_status")
  @@map("disputes")
}

model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  notificationType String    @map("notification_type") @db.VarChar(50)
  title            String    @db.VarChar(255)
  message          String
  data             Json?
  channels         String[]  @default(["push"]) @db.VarChar(20)
  isRead           Boolean?  @default(false) @map("is_read")
  sentAt           DateTime? @map("sent_at") @db.Timestamp(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([notificationType], map: "idx_notifications_type")
  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notifications_user")
  @@map("notifications")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  token      String    @unique
  deviceInfo Json?     @map("device_info")
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  isRevoked  Boolean?  @default(false) @map("is_revoked")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model UserVerification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  verificationType String    @map("verification_type") @db.VarChar(20)
  verificationCode String?   @map("verification_code") @db.VarChar(10)
  /// For checks made before an account exists (email-first sign-up): the address being verified.
  target           String?   @db.VarChar(255)
  isVerified       Boolean?  @default(false) @map("is_verified")
  expiresAt        DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_verifications_user")
  @@index([target], map: "idx_user_verifications_target")
  @@map("user_verifications")
}

model UserAddress {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  label        String    @default("Delivery address") @db.VarChar(80)
  fullName     String    @map("full_name") @db.VarChar(100)
  phoneNumber  String    @map("phone_number") @db.VarChar(20)
  addressLine1 String    @map("address_line1") @db.VarChar(200)
  addressLine2 String?   @map("address_line2") @db.VarChar(200)
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(100)
  postalCode   String?   @map("postal_code") @db.VarChar(20)
  country      String    @default("Nigeria") @db.VarChar(100)
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_addresses_user")
  @@map("user_addresses")
}

model PaymentTransaction {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  walletTransactionId String?   @map("wallet_transaction_id") @db.Uuid
  paymentGateway      String    @map("payment_gateway") @db.VarChar(20)
  gatewayReference    String?   @unique @map("gateway_reference") @db.VarChar(255)
  amount              Decimal   @db.Decimal(15, 2)
  currency            String?   @default("NGN") @db.VarChar(3)
  paymentMethod       String?   @map("payment_method") @db.VarChar(50)
  status              String?   @default("pending") @db.VarChar(20)
  gatewayResponse     Json?     @map("gateway_response")
  metadata            Json?
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  // Relations
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, createdAt(sort: Desc)], map: "idx_payment_transactions_status")
  @@index([userId], map: "idx_payment_transactions_user")
  @@map("payment_transactions")
}

model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  action       String    @db.VarChar(100)
  resourceType String?   @map("resource_type") @db.VarChar(50)
  resourceId   String?   @map("resource_id") @db.Uuid
  changes      Json?
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action, createdAt(sort: Desc)], map: "idx_audit_logs_action")
  @@index([resourceType, resourceId], map: "idx_audit_logs_resource")
  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_logs_user")
  @@map("audit_logs")
}

model UserRiskFlag {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  flagType     String    @map("flag_type") @db.VarChar(50)
  severity     String    @default("medium") @db.VarChar(20)
  reason       String
  signalCount  Int       @default(1) @map("signal_count")
  lastSignalAt DateTime  @default(now()) @map("last_signal_at") @db.Timestamp(6)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, flagType], map: "user_risk_flags_user_id_flag_type_key")
  @@index([userId, resolvedAt, lastSignalAt(sort: Desc)], map: "idx_user_risk_flags_user")
  @@index([flagType, resolvedAt, lastSignalAt(sort: Desc)], map: "idx_user_risk_flags_type")
  @@map("user_risk_flags")
}

model SupportThread {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String    @map("seller_id") @db.Uuid
  status             String    @default("open") @db.VarChar(20)
  subject            String?   @db.VarChar(255)
  lastMessageAt      DateTime? @default(now()) @map("last_message_at") @db.Timestamp(6)
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(255)
  sellerUnreadCount  Int       @default(0) @map("seller_unread_count")
  adminUnreadCount   Int       @default(0) @map("admin_unread_count")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  seller   User             @relation("SellerSupportThreads", fields: [sellerId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([sellerId, status], map: "idx_support_threads_seller")
  @@index([status, lastMessageAt(sort: Desc)], map: "idx_support_threads_status")
  @@map("support_threads")
}

model SupportMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt], map: "idx_support_messages_thread")
  @@map("support_messages")
}

/// Expo push tokens, one row per installed app. A user can have several devices.
model PushToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(255)
  platform   String    @db.VarChar(10)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_push_tokens_user")
  @@map("push_tokens")
}

/// Auctions a user is watching (heart). Watchers get "ending soon" alerts.
model Watch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  auctionId String   @map("auction_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, auctionId], map: "watchlist_user_auction_key")
  @@index([auctionId], map: "idx_watchlist_auction")
  @@map("watchlist")
}

/// Proxy bidding: the system bids for the user, one increment at a time, up to maxAmount.
model AutoBid {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  auctionId   String   @map("auction_id") @db.Uuid
  maxAmount   Decimal  @map("max_amount") @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  /// Send an alert when bidding passes maxAmount.
  notifyOnMax Boolean  @default(true) @map("notify_on_max")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, auctionId], map: "auto_bids_user_auction_key")
  @@index([auctionId, isActive], map: "idx_auto_bids_auction_active")
  @@map("auto_bids")
}

/// "Alert me when it's listed": matched against auctions as they go live.
model SavedSearch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  query          String?   @db.VarChar(120)
  categorySlug   String?   @map("category_slug") @db.VarChar(100)
  maxPrice       Decimal?  @map("max_price") @db.Decimal(15, 2)
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_saved_searches_user")
  @@map("saved_searches")
}

/// Cards saved from successful Paystack payments. authorizationCode is never sent to the app.
model SavedCard {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @default("paystack") @db.VarChar(20)
  authorizationCode String   @map("authorization_code") @db.VarChar(100)
  signature         String   @db.VarChar(100)
  email             String   @db.VarChar(255)
  brand             String   @db.VarChar(30)
  last4             String   @db.VarChar(4)
  expMonth          String   @map("exp_month") @db.VarChar(2)
  expYear           String   @map("exp_year") @db.VarChar(4)
  bank              String?  @db.VarChar(100)
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, signature], map: "saved_cards_user_signature_key")
  @@map("saved_cards")
}

/// After delivery, buyer and seller rate each other (1–5) once per order.
model Rating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  score     Int      @db.SmallInt
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rater User  @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ratee User  @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, raterId], map: "ratings_order_rater_key")
  @@index([rateeId], map: "idx_ratings_ratee")
  @@map("ratings")
}

/// A buyer following a seller's store. Followers hear about new listings.
model Follow {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId String   @map("follower_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seller   User @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([followerId, sellerId], map: "follows_follower_seller_key")
  @@index([sellerId], map: "idx_follows_seller")
  @@map("follows")
}
