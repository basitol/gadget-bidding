# Server Configuration
NODE_ENV=development
# APP_ENV controls deployment target rules. Use staging on Render staging with Paystack test keys; use production only with live keys.
APP_ENV=development
PORT=3000
API_VERSION=v1

# Database — use DATABASE_URL as the single source of truth for Prisma
# Local example (no password): postgresql://abdulbasitquadri@localhost:5432/gadget_bidding
DATABASE_URL=postgresql://postgres:password@localhost:5432/gadget_bidding
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gadget_bidding
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Payment Gateways
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/paystack

MONNIFY_API_KEY=MK_TEST_xxxxxxxxxxxxxxxxxxxxx
MONNIFY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONNIFY_CONTRACT_CODE=xxxxxxxxxxxx
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/monnify

# SMS Provider (Termii)
TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=N-Alert
TERMII_API_URL=https://v3.api.termii.com/api

# Cloudinary (production uploads — when all three are set, images go to Cloudinary)
# Leave blank in local dev to use disk uploads in ./uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (Resend — replace re_xxxxxxxxx with your real API key)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# App URLs
# Production FRONTEND_URL must be HTTPS and must not point to localhost.
FRONTEND_URL=http://localhost:3000
# Production MOBILE_APP_URL must be the final app URL scheme or an HTTPS URL.
MOBILE_APP_URL=gadgetbid://

# Security — use strong random values in production (openssl rand -base64 48)
# See docs/SECURITY.md for the full checklist
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_READ_MAX_REQUESTS=1000
RATE_LIMIT_WRITE_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_AUTH_SESSION_MAX_REQUESTS=120
RATE_LIMIT_OTP_MAX_REQUESTS=6
RATE_LIMIT_BID_MAX_REQUESTS=60
RATE_LIMIT_WALLET_FUNDING_MAX_REQUESTS=10
RATE_LIMIT_WALLET_WITHDRAWAL_MAX_REQUESTS=10
RATE_LIMIT_PAYMENT_VERIFICATION_MAX_REQUESTS=60
RATE_LIMIT_SUPPORT_MESSAGE_MAX_REQUESTS=30
RATE_LIMIT_NOTIFICATION_MUTATION_MAX_REQUESTS=120
RATE_LIMIT_ADMIN_MUTATION_MAX_REQUESTS=120

# Platform Settings
PLATFORM_FEE_PERCENTAGE=5
MIN_BID_INCREMENT=100
DEFAULT_AUCTION_DURATION_HOURS=24
AUTO_EXTEND_MINUTES=5

# File Upload
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MAX_IMAGES_PER_GADGET=5

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
