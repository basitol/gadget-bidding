{
  "expo": {
    "name": "GadgetBid",
    "slug": "gadgetbid",
    "scheme": "gadgetbid",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93b60ed8-10e9-452e-8a85-8fe41c714d11"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gadgetbid.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.gadgetbid.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GadgetBid to access your photos so you can list gadgets.",
          "cameraPermission": "Allow GadgetBid to use your camera so you can photograph gadgets."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.426137391668-7uonb8dsd6cchim6tbteclmfga1tflf6"
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "93b60ed8-10e9-452e-8a85-8fe41c714d11"
      }
    },
    "owner": "basitolaitan27"
  }
}
