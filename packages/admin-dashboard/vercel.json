{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|uploads|favicon\\.ico|favicon\\.svg|robots\\.txt|sitemap\\.xml|llms\\.txt|og-image\\.png|site\\.webmanifest|apple-touch-icon\\.png|icon-.*\\.png|favicon-.*\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
