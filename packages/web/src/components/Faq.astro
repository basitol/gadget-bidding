---
const faqs = [
  {
    q: 'How do I know the gadget is real?',
    a: 'Every listing is reviewed by our team, the IMEI or serial is checked against stolen-device lists, and the gadget is inspected at our hub before it is delivered to you.',
  },
  {
    q: 'What if it fails inspection?',
    a: "The order is cancelled and the money held in escrow goes back to you. The seller is never paid for a gadget that doesn't match its listing.",
  },
  {
    q: 'How long do I have to pay after winning?',
    a: "You have 24 hours to pay for a winning bid. If you don't, the win lapses and your ₦1,000 bid commitment hold is forfeited.",
  },
  {
    q: 'Who can sell?',
    a: 'Registered Computer Village businesses. Apply in the app with your CAC details and owner ID; once verified you can list right away. A platform fee is charged only when an item sells.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <h2 class="overline" id="faq-title">05 · Questions</h2>
    <div class="list" data-reveal>
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .faq {
    max-width: 800px;
  }

  .list {
    margin-top: 24px;
  }

  details {
    border-top: 1px solid var(--line);
  }

  details:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 12px 0;
    font-size: 17px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-size: 20px;
    font-weight: 400;
    color: var(--muted);
  }

  details[open] summary::after {
    content: '−';
  }

  p {
    padding: 0 48px 20px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--slate);
  }
</style>
