---
import Icon3D from './Icon3D.astro';
import PhoneBrowse from './PhoneBrowse.astro';
import PhoneOrder from './PhoneOrder.astro';
import type { Icon3DName } from '../data/icons';
import { site } from '../data/site';

const perks: { icon: Icon3DName; text: string }[] = [
  { icon: 'bell', text: "Live alerts when you're outbid" },
  { icon: 'autobid', text: 'Auto-bid up to your max' },
  { icon: 'truck', text: 'Track your order through inspection' },
];
---

<section class="get-app" id="get-app" aria-labelledby="app-title">
  <div class="inner">
    <div class="copy" data-reveal="left">
      <img class="mark" src="/img/brand/logo-mark.svg" width="52" height="52" alt="" />
      <span class="overline">Get the app</span>
      <h2 class="h2" id="app-title">Stop haggling.<br /><span class="tone-brand">Start bidding.</span></h2>
      <p class="lead">Free to join. You only pay when you win.</p>
      <ul class="perks">
        {
          perks.map((p) => (
            <li>
              <Icon3D name={p.icon} size={32} />
              {p.text}
            </li>
          ))
        }
      </ul>
      <div class="ctas">
        <a class="btn btn-dark" href={site.appStoreUrl}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M11.2 8.5c0-1.6 1.3-2.3 1.3-2.4-.7-1-1.8-1.2-2.2-1.2-.9-.1-1.8.6-2.3.6-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.6-1.1 1.9-.3 4.6.8 6.1.5.7 1.1 1.6 1.9 1.5.8 0 1-.5 2-.5s1.2.5 2 .5 1.3-.8 1.8-1.5c.6-.8.8-1.6.8-1.7 0 0-1.6-.6-1.6-2.5zM9.7 3.8c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.8.9-.4.4-.7 1.1-.6 1.8.7.1 1.4-.3 1.8-.8z"
            ></path>
          </svg>
          Get it on iPhone
        </a>
        <a class="btn btn-dark" href={site.playStoreUrl} rel="noopener">Get it on Android</a>
      </div>
    </div>

    <div class="stage" aria-hidden="true" data-reveal="rise" style="--i: 1">
      <PhoneBrowse class="back" />
      <PhoneOrder class="front" />
    </div>
  </div>
</section>

<style>
  .get-app {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 56px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 88px 24px 0;
  }

  .copy {
    display: flex;
    flex: 1 1 420px;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 88px;
  }

  .mark {
    margin-bottom: 8px;
    border-radius: 14px;
  }

  .h2 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }

  .perks {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .perks li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 600;
  }

  .ctas {
    margin-top: 12px;
  }

  .stage {
    display: flex;
    flex: 1 1 460px;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    height: 400px;
    padding-top: 40px;
    overflow: hidden;
    border-radius: 28px 28px 0 0;
    background: var(--blue-50);
  }

  .stage :global(.back) {
    margin-top: 48px;
  }

  @media (max-width: 960px) {
    .copy {
      padding-bottom: 0;
    }
  }

  @media (max-width: 600px) {
    .inner {
      gap: 40px;
      padding-top: 64px;
    }

    .stage {
      height: 360px;
    }

    .stage :global(.back) {
      display: none;
    }
  }
</style>
