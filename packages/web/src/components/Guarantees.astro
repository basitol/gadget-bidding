---
import { guarantees, iconSrc } from '../data/landing';
---

<section aria-label="Guarantees" style="border-bottom: 1px solid #E6EAF2">
  <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))">
    {
      guarantees.map((g, i) => (
        <div data-reveal style={`--i: ${i}; padding: 22px 24px; border-right: 1px solid #E6EAF2; display: flex; align-items: center; gap: 14px`}>
          <span style="flex-shrink: 0"><img src={iconSrc(g.kind)} alt="" width="44" height="44" /></span>
          <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-weight: 700; font-size: 15px">{g.title}</span><span style="font-size: 13px; color: #5E6B8C">{g.sub}</span></span>
        </div>
      ))
    }
  </div>
</section>
